#X obj 30 120 notein;
#X obj 30 160 pack f f f;
#X msg 30 200 note \$1 \$2 \$3;
#X obj 200 120 ctlin;
#X obj 200 160 pack f f f;
#X msg 200 200 ctl \$1 \$2 \$3;
