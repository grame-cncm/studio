#N canvas 0 50 1380 1000 12;
#X declare -path ../pd-faustgen/external -lib faustgen2~;
#X text 30 20 Additive MIDI / synthese additive MIDI - 16 voices;
#X text 30 50 Audio: 0 inputs / entrees -> 2 outputs / sorties;
#X obj 400 50 loadbang;
#X obj 450 200 faustgen2~ faustgen-additive-poly-midi;
#X obj 450 250 print faustgen-additive-poly-midi;
#X obj 450 150 r \$0-faust;
#X obj 850 200 dac~ 1 2;
#X obj 800 100 nbx 5 14 0 1 0 0 empty empty output-level 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 800 60 0.2;
#X obj 800 150 *~;
#X obj 900 150 *~;
