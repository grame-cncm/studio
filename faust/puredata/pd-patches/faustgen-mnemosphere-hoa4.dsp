                offset = vslider("h:flanger/offset [unit:msec]", 10, 0, 200, 0.001) : si.smoo;
                fdbk = vslider("h:flanger/fdbk", 1, 0, 1, 0.001) : si.smoo;
                spread = vslider("h:flanger/spread", 0, 0, 1, 0.001) : si.smoo;
};
//
