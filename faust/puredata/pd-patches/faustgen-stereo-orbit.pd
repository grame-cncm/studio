#N canvas 0 50 1380 700 12;
#X declare -path ../pd-faustgen/external -lib faustgen2~;
#X text 30 20 Stereo Orbit / Orbite stereo - eight speakers / huit enceintes;
#X text 30 50 Audio: 2 inputs / entrees -> 8 outputs / sorties;
#X obj 400 50 loadbang;
#X obj 450 200 faustgen2~ faustgen-stereo-orbit;
#X obj 450 250 print faustgen-stereo-orbit;
#X obj 450 150 r \$0-faust;
#X obj 30 100 adc~ 1 2;
#X obj 200 100 tgl 15 0 empty empty test-tones 17 7 0 10 -262144 -1 -1 0 1;
#X obj 300 100 == 0;
#X msg 300 60 0;
#X obj 30 140 osc~ 220;
#X obj 30 175 *~ 0.1;
#X obj 30 210 *~;
#X obj 110 175 *~;
#X obj 30 260 +~;
#X obj 210 140 osc~ 330;
#X obj 210 175 *~ 0.1;
#X obj 210 210 *~;
#X obj 290 175 *~;
#X obj 210 260 +~;
#X obj 850 200 dac~ 1 2 3 4 5 6 7 8;
#X text 30 330 azimuth (turn);
#X obj 30 350 nbx 5 14 0 1 0 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 120 350 azimuth \$1;
#X msg 30 380 0.0;
#X text 360 330 counterrotate;
#X obj 360 350 nbx 5 14 0 1 0 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 450 350 counterrotate \$1;
#X msg 360 380 1.0;
#X text 690 330 level;
#X obj 690 350 nbx 5 14 0 1 0 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 780 350 level \$1;
#X msg 690 380 0.5;
#X text 1020 330 running;
#X obj 1020 350 nbx 5 14 0 1 0 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 1110 350 running \$1;
#X msg 1020 380 1.0;
#X text 30 415 speed (Hz);
#X obj 30 435 nbx 5 14 -1 1 0 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 120 435 speed \$1;
#X msg 30 465 0.08;
#X text 360 415 spread;
#X obj 360 435 nbx 5 14 0 1 0 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 450 435 spread \$1;
#X msg 360 465 0.0;
#X text 690 415 width (turn);
#X obj 690 435 nbx 5 14 0 1 0 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 256;
#X msg 780 435 width \$1;
#X msg 690 465 0.25;
#X msg 1050 60 compile;
#X obj 1050 110 tgl 15 0 empty empty autocompile 17 7 0 10 -262144 -1 -1 0 1;
#X msg 1080 150 autocompile \$1 100;
#X obj 1050 250 tgl 15 0 empty empty DSP 17 7 0 10 -262144 -1 -1 0 1;
#X msg 1100 250 dsp \$1;
#X obj 1200 250 s pd;
#X text 30 670 Edit .dsp then compile / modifier le .dsp puis compiler;
