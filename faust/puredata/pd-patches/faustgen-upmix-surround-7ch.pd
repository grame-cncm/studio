#N canvas 0 50 1380 700 12;
#X declare -path ../pd-faustgen/external -lib faustgen2~;
#X text 30 20 Stereo upmix 2 to 7.0 / upmix stereo 2 vers 7.0;
#X text 30 50 Audio: 2 inputs / entrees -> 7 outputs / sorties;
