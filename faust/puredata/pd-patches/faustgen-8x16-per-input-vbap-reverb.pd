#N canvas 0 50 1380 1030 12;
#X declare -path ../pd-faustgen/external -lib faustgen2~;
#X text 30 20 Independent 8x16 VBAP + Freeverb;
#X text 30 50 Audio: 8 inputs / entrees -> 16 outputs / sorties;
